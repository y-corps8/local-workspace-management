{
  "name": "locws",
  "version": "0.1.1-beta.2",
  "license": "MIT",
  "description": "Localhost dashboard to run allowlisted commands across project folders",
  "engines": {
    "node": ">=20.6.0"
  },
  "bin": {
    "locws": "./src/server.mjs"
  },
  "files": [
    "src",
    "public",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y-corps8/local-workspace-management.git"
  },
  "homepage": "https://github.com/y-corps8/local-workspace-management#readme",
  "bugs": {
    "url": "https://github.com/y-corps8/local-workspace-management/issues"
  },
  "scripts": {
    "start": "node src/server.mjs start",
    "start:browser": "node src/server.mjs start --browser",
    "start:window": "node src/server.mjs start --window",
    "test": "node --import ./test/preload.mjs --test test/*/*.test.mjs"
  }
}
