          "argv": ["echo", "Hello from overview"]
        },
        {
          "script": "confirm",
          "group": "tools",
          "label": "confirm",
          "argv": [
            "node",
            "-e",
            "process.stdout.write('Continue? (y/N) ');process.stdin.resume();process.stdin.once('data',(d)=>{process.stdout.write('\\n'+String(d).trim()+'\\n');process.exit(0);})"
          ]
        },
        {
          "script": "fmt",
          "group": "lint",
          "label": "lint",
          "hint": "Custom group sample.",
          "argv": ["echo", "lint group"]
        }
      ]
    },
    {
